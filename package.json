{
  "name": "@xrdavies/x-auto",
  "version": "0.1.0",
  "private": false,
  "description": "X browser automation using normal Chrome profiles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xrdavies/x-auto.git"
  },
  "homepage": "https://github.com/xrdavies/x-auto#readme",
  "bugs": {
    "url": "https://github.com/xrdavies/x-auto/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "scripts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "x-auto": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/tests/*.test.ts",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test",
    "dev": "tsx src/cli.ts",
    "serve": "node dist/server.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.1",
  "dependencies": {
    "@agent-infra/browser": "0.2.1",
    "puppeteer-core": "24.23.0",
    "react": "19.2.3",
    "twitter-text": "3.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
